# ---------------------------------------------------------------------------
# Quareia Companion backend — example environment.
#
# Copy to `.env` and edit. NEVER commit a real `.env` or paste real secrets
# into issues/PRs. All values are optional in dev (sane defaults apply).
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# SQLite for local dev. For production use PostgreSQL, e.g.:
#   postgresql+psycopg://user:password@host:5432/quareia
DATABASE_URL=sqlite:///./dev.db

# Create tables on startup (dev/tests only). Production should run Alembic.
CREATE_TABLES_ON_STARTUP=true

# --- App --------------------------------------------------------------------
# One of: dev | production. When production, the app fails fast at startup
# unless SECRET_KEY is strong, MAIL_PROVIDER != devtest, and DATABASE_URL is
# PostgreSQL (see Settings.validate_for_production).
ENVIRONMENT=dev
# Base URL the public sees (no trailing slash). Used to build links in emails.
PUBLIC_BASE_URL=http://localhost:8000
# Comma-separated allowed origins for CORS. Empty => allow all in dev.
# Example: https://example.com,https://app.example.com
CORS_ALLOW_ORIGINS=

# --- Security ---------------------------------------------------------------
# Server-wide HMAC secret for verification-code and device-token digests.
# MUST be a stable, high-entropy value in production; any change invalidates
# all outstanding codes and tokens. The dev default below is rejected in prod.
SECRET_KEY=dev-insecure-secret-key-do-not-use-in-prod

# --- Auth / verification codes ---------------------------------------------
# Seconds a code stays valid (default 600 = 10 minutes).
EMAIL_CODE_TTL_SECONDS=600
# Minimum seconds between two code requests for the same email (default 60).
EMAIL_RESEND_MIN_INTERVAL_SECONDS=60

# --- Mail provider ----------------------------------------------------------
# One of: devtest | resend | smtp. devtest captures mail in memory (tests/dev
# only) and is REFUSED when ENVIRONMENT=production.
MAIL_PROVIDER=devtest

MAIL_FROM_ADDRESS=no-reply@your-domain.example
MAIL_FROM_NAME=Quareia Companion

# Resend (https://resend.com) — set MAIL_PROVIDER=resend and provide a key.
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com/emails

# SMTP — set MAIL_PROVIDER=smtp and provide host/credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# --- Notes entitlements -----------------------------------------------------
# Notes is an OPTIONAL feature (future-paid). NOTES_ENABLED_FOR_ALL=true grants
# access to everyone in dev/tests via AllowAllEntitlementService. In production
# set this to false (the default then becomes DenyAllEntitlementService) and
# inject a real per-user EntitlementService implementation (e.g. backed by a
# subscription store). Payments are out of scope for this round; business code
# never hard-codes "paid => allowed".
NOTES_ENABLED_FOR_ALL=true
