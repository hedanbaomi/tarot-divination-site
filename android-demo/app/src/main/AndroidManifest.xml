<?xml version="1.0" encoding="utf-8"?>
<!--
  INTERNET is used only for the anonymous, opt-out usage statistics, for the
  startup/manual update check against GitHub Releases, and to download the
  update APK the user confirms. The entire website is bundled in assets/www
  and runs offline inside the WebView; divination and local history work
  without any network. Telemetry can be turned off in the About screen.
  REQUEST_INSTALL_PACKAGES lets the in-app updater hand a downloaded APK to
  the system package installer only after the user explicitly confirms the
  update and grants that capability in system settings. No location,
  device-identifier, contacts, or account permissions are requested.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:name=".QuareiaApplication"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.QuareiaDivination">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!--
          About / Copyright & Attribution screen. Not exported and started only
          from the in-app button; it needs no permissions of its own. The
          Quareia link it offers is handed to the system browser.
        -->
        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:label="@string/about_title"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode" />
        <!--
          Announcements screen. Not exported; opened from the About screen and
          lists all fetched announcements with a manual refresh. Content is
          plain text rendered by the activity, never HTML.
        -->
        <activity
            android:name=".AnnouncementsActivity"
            android:exported="false"
            android:label="@string/announcements_title"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode" />
        <!--
          Exposes downloaded update APKs to the system package installer over
          a content:// URI (file:// URIs are rejected since Android 7). The
          provider only serves files under the app's internal updates dir.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updatefileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths" />
        </provider>
    </application>

</manifest>
