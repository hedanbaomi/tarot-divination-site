<?xml version="1.0" encoding="utf-8"?>
<!--
  No permissions required: the entire website is bundled in assets/www and
  runs offline inside the WebView. localStorage (used for the divination
  history) is provided by WebView's DOM storage, not by a filesystem permission.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.QuareiaDivination">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!--
          About / Copyright & Attribution screen. Not exported and started only
          from the in-app button; it needs no permissions of its own. The
          Quareia link it offers is handed to the system browser.
        -->
        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:label="@string/about_title"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode" />
    </application>

</manifest>
