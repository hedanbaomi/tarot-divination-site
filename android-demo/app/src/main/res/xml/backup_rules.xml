<?xml version="1.0" encoding="utf-8"?>
<!-- API 24-30. SharedPreferences backup paths include the .xml suffix.
     WebView Local Storage cannot be filtered by key, so exclude the entire
     WebView directory, including its history, conversations and settings.
     Users can transfer history and conversations with manual JSON backups. -->
<full-backup-content>
    <exclude domain="sharedpref" path="quareia_ai_config.xml"/>
    <exclude domain="root" path="app_webview/"/>
</full-backup-content>
