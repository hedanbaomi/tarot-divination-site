<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+. Apply the same credential exclusions to cloud backup and
     device transfer. Excluding app_webview also excludes its user data;
     manual JSON export/import is unaffected. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="quareia_ai_config.xml"/>
        <exclude domain="root" path="app_webview/"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="quareia_ai_config.xml"/>
        <exclude domain="root" path="app_webview/"/>
    </device-transfer>
</data-extraction-rules>
