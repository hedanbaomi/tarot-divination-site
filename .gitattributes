# Keep content-hashed assets byte-identical in Windows and Linux checkouts.
/js/**/*.js text eol=lf
/css/**/*.css text eol=lf
# These two existing blobs already contain CRLF. Preserve their published bytes.
/js/app.js -text
/css/redesign.css -text
/android-demo/gradlew text eol=lf
# The existing index mixes LF and CRLF. Keep both when refreshing URLs.
/index.html -text whitespace=trailing-space,space-before-tab,cr-at-eol
